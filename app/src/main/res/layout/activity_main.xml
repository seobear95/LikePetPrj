<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1단계: 좋아하는 강아지를 선택하세요"
            android:textSize="22sp"
            android:textStyle="bold"/>

        <EditText
            android:id="@+id/editDogName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="애완견 이름 입력 예: 초코"
            android:inputType="textPersonName"
            android:layout_marginTop="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="희망하는 강아지를 선택하세요"
            />

        <Spinner android:id="@+id/dogSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            ></Spinner>
        <TextView
            android:id="@+id/friendLevelText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="강아지 친화도를 선택하세요"
            />
        <SeekBar
            android:id="@+id/friendLevelSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="10"
            android:progress="5"></SeekBar>

        <CheckBox
            android:id="@+id/DogCheckWalk"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="매일 산책 가능"/>
        <CheckBox
            android:id="@+id/DogCheckPlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="매일 놀아주기 가능"/>
        <CheckBox
            android:id="@+id/DogCheckClean"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="매일 목욕 가능"/>

        <Button
            android:id="@+id/btnNextCat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="고양이 선택 화면으로 이동"/>
    </LinearLayout>
</ScrollView>
